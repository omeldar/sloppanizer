    "@modelcontextprotocol/sdk": "^1.32.2",
    "@organizer/mcp": "workspace:*",
    "@organizer/shared": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
