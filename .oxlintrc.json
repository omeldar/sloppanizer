{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "promise", "import", "vitest", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.d.ts", "tmp/**", "**/coverage/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    // Our own components take a `role` prop (requester or contact); only DOM roles are ARIA roles.
    "jsx-a11y/aria-role": ["error", { "ignoreNonDOM": true }],
    // We use valid ARIA on purpose: role="group" for rows of toggle buttons, role="status" for live
    // messages, a listbox for the topic combobox. The native tags would bring form or widget behaviour.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Markdown renders through the sanitizer; raw HTML strings never reach the DOM.
    "react/no-danger": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "env": { "browser": true }
    },
    {
      "files": ["apps/server/**", "apps/mcp/**", "*.config.*", "deploy/**"],
      "env": { "node": true }
    }
  ]
}
