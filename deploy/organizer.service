# systemd user unit for organizer. deploy/install.sh fills in the @...@ values and writes it to
# ~/.config/systemd/user/organizer.service; edit this template, not the written copy.
[Unit]
Description=organizer, personal todos and notes (http://organizer.localhost:@PORT@)
After=network.target

[Service]
Type=simple
# "current" is a symlink to the active release; restart after switching it.
WorkingDirectory=@CURRENT@
ExecStart=@NODE@ @CURRENT@/server/src/index.ts
Environment=NODE_ENV=production
Environment=ORGANIZER_PORT=@PORT@
Environment=ORGANIZER_WEB_DIR=@CURRENT@/web
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
